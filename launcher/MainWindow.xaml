<Window x:Class="StuntmanLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StuntmanLauncher"
        Title="Stuntman: Ignition"
        Width="1080" Height="660"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Icon="icon.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Yellow and black hazard stripes, as on a clapperboard -->
    <DrawingBrush x:Key="HazardBrush" TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute"
                  Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{StaticResource AccentBrush}" Geometry="M0,0 L36,0 36,36 0,36 Z" />
          <GeometryDrawing Brush="{StaticResource InkBrush}"
                           Geometry="M0,0 L18,0 0,18 Z M36,0 L36,18 18,36 0,36 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ Left: key art and Play ============ -->
    <Grid Grid.Column="0" ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF24242A" Offset="0" />
          <GradientStop Color="#FF101012" Offset="0.75" />
        </LinearGradientBrush>
      </Grid.Background>

      <!-- Speed streaks -->
      <Canvas IsHitTestVisible="False">
        <Canvas.RenderTransform>
          <RotateTransform Angle="-24" CenterX="210" CenterY="330" />
        </Canvas.RenderTransform>
        <Rectangle Canvas.Left="-80" Canvas.Top="180" Width="560" Height="3" Opacity="0.35">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFC400" Offset="0" />
              <GradientStop Color="#FFFFC400" Offset="0.8" />
              <GradientStop Color="#00FFC400" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Canvas.Left="20" Canvas.Top="214" Width="420" Height="1" Opacity="0.25" Fill="White" />
        <Rectangle Canvas.Left="-140" Canvas.Top="470" Width="640" Height="2" Opacity="0.18">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0" />
              <GradientStop Color="#FFFFFFFF" Offset="0.7" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Canvas.Left="60" Canvas.Top="500" Width="380" Height="5" Opacity="0.22">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFC400" Offset="0" />
              <GradientStop Color="#FFFFC400" Offset="0.9" />
              <GradientStop Color="#00FFC400" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Canvas>

      <!-- Big faint star -->
      <Path IsHitTestVisible="False" Fill="#0CFFC400" Stroke="#18FFC400" StrokeThickness="2"
            Data="M 200,40 L 247,147 362,157 274,233 301,346 200,286 99,346 126,233 38,157 153,147 Z"
            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-120,40">
        <Path.RenderTransform>
          <RotateTransform Angle="14" />
        </Path.RenderTransform>
      </Path>

      <!-- Clapperboard band -->
      <Border Height="30" VerticalAlignment="Top" Margin="-40,34,-40,0" Background="{StaticResource HazardBrush}">
        <Border.RenderTransform>
          <RotateTransform Angle="-5" />
        </Border.RenderTransform>
      </Border>

      <StackPanel Margin="44,120,36,0" VerticalAlignment="Top">
        <TextBlock Text="STUNTMAN" FontFamily="{StaticResource UiFont}" FontSize="76" FontWeight="Bold"
                   FontStretch="Condensed" Foreground="{StaticResource TextBrush}">
          <TextBlock.RenderTransform>
            <SkewTransform AngleX="-12" />
          </TextBlock.RenderTransform>
          <TextBlock.Effect>
            <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="5" Direction="315" Opacity="0.8" />
          </TextBlock.Effect>
        </TextBlock>
        <Grid Margin="4,-6,0,0" HorizontalAlignment="Left">
          <Border Background="{StaticResource AccentBrush}" Padding="12,2,16,4">
            <Border.RenderTransform>
              <SkewTransform AngleX="-12" />
            </Border.RenderTransform>
            <TextBlock Text="IGNITION" FontFamily="{StaticResource UiFont}" FontSize="34" FontWeight="Bold"
                       FontStretch="Condensed" Foreground="{StaticResource InkBrush}" />
          </Border>
        </Grid>
        <TextBlock Text="{x:Static local:L.Tagline}" Margin="6,18,0,0" FontFamily="{StaticResource UiFont}"
                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DimTextBrush}" />
        <TextBlock Text="{x:Static local:L.InGameMenu}" Margin="6,22,0,0" TextWrapping="Wrap" LineHeight="19"
                   FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource DimTextBrush}" />
      </StackPanel>

      <StackPanel VerticalAlignment="Bottom" Margin="44,0,44,34">
        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="{x:Static local:L.Play}"
                Click="OnPlay" />
        <TextBlock x:Name="StatusText" Margin="2,16,0,0" TextWrapping="Wrap" MinHeight="36"
                   FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource DimTextBrush}" />
        <TextBlock x:Name="VersionText" Margin="2,4,0,0" FontFamily="{StaticResource UiFont}" FontSize="11"
                   Foreground="#FF55555E" />
        <!-- Shown when GitHub has a newer release (MainWindow.Update.cs) -->
        <Button x:Name="UpdateButton" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                Margin="0,10,0,0" Visibility="Collapsed" Click="OnUpdate" />
      </StackPanel>
    </Grid>

    <!-- ============ Right: saves (or the installer) ============ -->
    <Grid x:Name="RightPanel" Grid.Column="1" Background="{StaticResource PanelBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" />
        <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="OnClose" />
      </StackPanel>

      <!-- Install mode: shown when the game isn't next to the launcher -->
      <Grid x:Name="InstallPanel" Grid.Row="1" Grid.RowSpan="2" Margin="40,8,40,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="InstallForm">
          <TextBlock Text="{x:Static local:L.InstallTitle}" FontFamily="{StaticResource UiFont}" FontSize="13"
                     FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,6" />
          <TextBlock Text="{x:Static local:L.InstallIntro}" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}"
                     FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

          <TextBlock Text="{x:Static local:L.IsoLabel}" FontFamily="{StaticResource UiFont}" FontSize="13"
                     Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RowActiveBrush}" Padding="12,8">
              <TextBlock x:Name="IsoPath" Text="{x:Static local:L.IsoPick}" TextTrimming="CharacterEllipsis"
                         FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource DimTextBrush}" />
            </Border>
            <Button x:Name="IsoBrowse" Grid.Column="1" Style="{StaticResource FlatButton}"
                    Content="{x:Static local:L.Browse}" Click="OnPickIso" />
          </Grid>
          <TextBlock x:Name="IsoStatus" FontFamily="{StaticResource UiFont}" FontSize="12" MinHeight="16"
                     Margin="2,0,0,10" />

          <TextBlock Text="{x:Static local:L.FolderLabel}" FontFamily="{StaticResource UiFont}" FontSize="13"
                     Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RowActiveBrush}" Padding="12,8">
              <TextBlock x:Name="InstallDirText" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UiFont}"
                         FontSize="14" Foreground="{StaticResource TextBrush}" />
            </Border>
            <Button x:Name="DirBrowse" Grid.Column="1" Style="{StaticResource FlatButton}"
                    Content="{x:Static local:L.Browse}" Click="OnPickDir" />
          </Grid>

          <StackPanel x:Name="KeepBuildHost" />
          <TextBlock Text="{x:Static local:L.InstallNeeds}" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}"
                     FontSize="12" LineHeight="17" Foreground="{StaticResource DimTextBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Progress: one row per step, plus the log -->
        <Grid x:Name="InstallProgressPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="InstallSteps" Margin="0,8,0,8" />
          <TextBox x:Name="InstallLog" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                   Background="{StaticResource WindowBrush}" Foreground="{StaticResource DimTextBrush}"
                   BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8" />
          <Button x:Name="ShowLogButton" Grid.Row="2" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Style="{StaticResource SmallButton}" Content="{x:Static local:L.ShowLog}" Click="OnShowLog" />
        </Grid>
      </Grid>

      <TextBlock x:Name="SavesTitle" Grid.Row="1" Text="{x:Static local:L.TabSaves}" Margin="40,8,40,0"
                 FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" />

      <!-- Saves: built in MainWindow.Saves.cs -->
      <ScrollViewer x:Name="SavesPanel" Grid.Row="2" Margin="40,0,24,24"
                    VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="SavesContent" Margin="0,0,16,0" />
      </ScrollViewer>
    </Grid>

    <!-- Yes/No confirmation over the whole window -->
    <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Background="#CC0B0B0D" Visibility="Collapsed">
      <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="4,0,0,0" Padding="32,28">
        <StackPanel>
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="17"
                     LineHeight="24" Foreground="{StaticResource TextBrush}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="ConfirmNo" Style="{StaticResource FlatButton}" Content="{x:Static local:L.No}"
                    IsCancel="True" />
            <Button x:Name="ConfirmYes" Style="{StaticResource DangerButton}" Content="{x:Static local:L.Yes}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
